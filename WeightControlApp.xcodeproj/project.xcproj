    ],
  },
  "files": [
    { "kind": "folder", "path": "WeightControlApp", "target-membership": [ "WeightControlApp" ] },
    { "kind": "folder", "path": "WeightControlAppTests", "target-membership": [ "WeightControlAppTests" ] },
    { "kind": "folder", "path": "WeightControlAppUITests", "target-membership": [ "WeightControlAppUITests" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "WeightControlApp", "WeightForecastWidgetExtension", "WeightForecastWatch", "WeightForecastWatchWidgetExtension" ] },
    {
      "kind": "folder",
      "path": "WeightForecastWatch",
      "target-membership": [ "WeightForecastWatch" ],
    },
    {
      "kind": "folder",
      "path": "WeightForecastWatchWidget",
      "target-membership": [ "WeightForecastWatchWidgetExtension" ],
      "membership-exceptions": [
        { "target": "WeightForecastWatchWidgetExtension", "exclusions": [ "Info.plist" ] },
      ],
    },
    {
      "kind": "folder",
      "path": "WeightForecastWidget",
      "target-membership": [ "WeightForecastWidgetExtension" ],
      "membership-exceptions": [
        { "target": "WeightForecastWidgetExtension", "exclusions": [ "Info.plist" ] },
      ],
    },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/WeightControlApp.app", "id": "1B9F877E30AFECFA008ABEC0", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/WeightControlAppTests.xctest", "id": "1B9F878D30AFECFC008ABEC0", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/WeightControlAppUITests.xctest", "id": "1B9F879730AFECFC008ABEC0", "type": "wrapper.cfbundle", "index": false },
