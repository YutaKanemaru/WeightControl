        { "path": "<PRODUCTS>/WeightForecastWatch.app", "id": "5C1E8A2F4B7D9036E1A2C3D4", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "WeightControlApp/copy/Embed Watch Content", "code-sign-on-copy": true } ] },
        { "path": "<PRODUCTS>/WeightForecastWatchWidgetExtension.appex", "id": "6D2F9B3A5C8E0147F2B3D4E5", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "WeightForecastWatch/copy/Embed Foundation Extensions", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
      ],
